{
  "name": "interverse-socket-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build:alpha": "cross-env NODE_ENV=alpha tsc",
    "build:prod": "cross-env NODE_ENV=production tsc",
    "start:dev": "cross-env NODE_ENV=development tsnd --transpile-only -r tsconfig-paths/register src/index.ts",
    "start:alpha": "pnpm run build:alpha && cross-env NODE_ENV=alpha node dist/index.js",
    "start:prod": "pnpm run build:prod && cross-env NODE_ENV=production node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ioredis": "^5.4.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "mediasoup": "^3.15.7",
    "module-alias": "^2.2.3",
    "socket.io": "^4.7.4",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/module-alias": "^2.0.4",
    "@types/node": "^20.11.21",
    "@types/socket.io": "^3.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  },
  "_moduleAliases": {
    "@handlers": "dist/handlers",
    "@interfaces": "dist/interfaces",
    "@managers": "dist/managers",
    "@repositories": "dist/repositories",
    "@config": "dist/config",
    "@db": "dist/db"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "mediasoup"
    ]
  }
}
